-_BRAND_SCAN_JS = r"""
-(modal, brand) => {
-  const norm = s => (s || '').normalize('NFKC').replace(/[\s\-_./()]+/g, '').toLowerCase();
-  const target = norm(brand);
-  const radios = [...modal.querySelectorAll('input[name="layer_brand"]')];
-  const rows = radios.map((r, i) => {
-    const label = r.labels && r.labels[0];
-    return { index: i, code: r.value, text: (label ? label.textContent : '').trim() };
-  });
-  const matches = rows.filter(r => target && norm(r.text) === target);
-  return { found: matches.length === 1, ambiguous: matches.length > 1,
-           ...(matches.length === 1 ? matches[0] : {}), rows };
-}
-"""
