-def open_register_form(page: Page, mall: Mall) -> None:
-    # A failed preparation or a dry run leaves an unsaved form at this same URL.
-    # Each item needs a fresh form, including empty optional fields and layers.
-    for attempt in range(3):
-        try:
-            page.goto(mall.register_url, wait_until="domcontentloaded")
-            break
-        except PWError as exc:
-            # A previous save's delayed reload can interrupt the next GET.
-            # Retry only before filling anything; never replay a save POST.
-            transient = any(code in str(exc) for code in (
-                "net::ERR_ABORTED", "net::ERR_CONNECTION_RESET",
-                "net::ERR_CONNECTION_CLOSED", "net::ERR_CONNECTION_TIMED_OUT",
-                "net::ERR_TIMED_OUT", "net::ERR_EMPTY_RESPONSE",
-            ))
-            if not transient or attempt == 2:
-                raise
-            _log("등록 화면 연결을 다시 시도합니다.")
-            page.wait_for_timeout(250 * (attempt + 1))
-    require_admin_origin(page.url, mall)
-    page.wait_for_selector(SEL["goods_name"], timeout=config.UI_TIMEOUT_MS)
-    if "login" in page.url or not page.query_selector(SEL["form"]):
-        raise RegisterError(f"{mall.label} 관리자 로그인이 필요합니다.")
-    # SmartEditor2 준비 대기
-    try:
-        page.wait_for_function(
-            "() => window.oEditors && oEditors.getById && oEditors.getById['editor']",
-            timeout=config.UI_TIMEOUT_MS,
-        )
-    except PWTimeout:
-        raise RegisterError("상세설명 에디터가 로딩되지 않았습니다.")
