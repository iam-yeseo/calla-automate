-def _parse_admin_time(value: str) -> Optional[datetime]:
-    text = str(value or "").strip()
-    if not text:
-        return None
-    try:
-        parsed = datetime.fromisoformat(text.replace("Z", "+00:00"))
-    except ValueError:
-        match = re.search(r"(\d{4})[./-](\d{2})[./-](\d{2})\s+(\d{2}):(\d{2})(?::(\d{2}))?", text)
-        if not match:
-            return None
-        try:
-            parsed = datetime(*(int(part or 0) for part in match.groups()))
-        except ValueError:
-            return None
-    # A date without time cannot identify which registration attempt created it.
-    if not re.search(r"[T\s]\d{2}:\d{2}", text):
-        return None
-    return parsed.replace(tzinfo=timezone(timedelta(hours=9))) if parsed.tzinfo is None else parsed
