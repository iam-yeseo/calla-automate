{
  "name": "calla-automate",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "desktop:icons": "node scripts/build-desktop-icons.mjs",
    "desktop:build": "npm run build && npm run desktop:icons",
    "desktop:start": "electron .",
    "desktop:package": "npm run desktop:build && electron-builder --config desktop/builder.json --mac --arm64",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "test:desktop:ui": "playwright test --config desktop/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "miniflare": "5.20260926.1-alpha",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.144.0"
  },
  "main": "desktop/main.cjs",
  "description": "CALLA 상품 운영 및 고도몰 등록 macOS 앱",
  "author": "CALLA",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "http-cache-semantics": "4.3.0",
    "source-map-js": "1.2.2",
    "miniflare": {
      "sharp": "0.35.5"
    },
    "global-agent": "4.1.3"
  }
}
