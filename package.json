{
  "name": "calla-automate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:runner": "python3 -m unittest discover -s runner/tests -v",
    "preview": "vite preview --host 127.0.0.1",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "exceljs": "4.4.0",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.144.0"
  }
}
